{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NLsearch",
  "version": "0.1.0",
  "identifier": "com.jason7773.nlsearch",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "NLsearch",
        "width": 920,
        "height": 680,
        "minWidth": 560,
        "minHeight": 400,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#202020"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MDkzNDcwRTE1ODYxQUQKUldTdFlWamhjRFFKWndjTVpYR050dlloMmpnZEZtWC9ZU2o3bUxmUWsrcE0veThXc2V4OC9LcncK",
      "endpoints": [
        "https://github.com/jason7773/NLsearch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
